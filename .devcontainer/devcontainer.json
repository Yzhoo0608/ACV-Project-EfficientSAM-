{
  "name": "ACV Project",
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile"
  },

  "runArgs": [
    "--gpus",
    "all",
    "--ipc=host"   
  ],

  "workspaceFolder": "/workspace",

  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  }
}